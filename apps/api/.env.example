# Full reference list of apps/api environment variables.
# - Local dev: copy to `.env.development.local` (git-ignored) and fill in
#   values from the DEV Supabase project. See docs/ENVIRONMENTS.md.
# - Deployed environments (Render): set these directly in that service's
#   dashboard — production and dev are two separate Render services with
#   two separate sets of values. Never share prod values into the dev service.
NODE_ENV=development
API_PORT=3000
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_JWT_SECRET=your-jwt-secret-here
APP_BASE_URL=http://localhost:5173
API_PUBLIC_BASE_URL=http://localhost:3000/api
PAYSTACK_PUBLIC_KEY=your-paystack-public-here
PAYSTACK_SECRET_KEY=your-paystack-secret-here
DAILY_API_KEY=your-daily-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-5-mini
SENTRY_DSN=
REDIS_URL=redis://localhost:6379
