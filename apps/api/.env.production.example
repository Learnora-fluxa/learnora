# Reference only — production never reads a local .env file. These are the
# values that must be set in the `learnora-api` Render service's dashboard,
# using your PRODUCTION Supabase project.
NODE_ENV=production
API_PORT=3000
SUPABASE_URL=https://<your-prod-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-prod-service-role-key
SUPABASE_JWT_SECRET=your-prod-jwt-secret
APP_BASE_URL=https://app.learnora.example
API_PUBLIC_BASE_URL=https://api.learnora.example/api
PAYSTACK_PUBLIC_KEY=your-paystack-live-public-key
PAYSTACK_SECRET_KEY=your-paystack-live-secret-key
DAILY_API_KEY=your-daily-prod-api-key
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5-mini
SENTRY_DSN=
REDIS_URL=redis://your-prod-redis-host:6379
SUPER_ADMIN_BOOTSTRAP_SECRET=
