# Copy to apps/api/.env.development.local and fill in DEV Supabase project values.
# Never put production credentials in this file.
NODE_ENV=development
API_PORT=3000
SUPABASE_URL=https://<your-dev-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-dev-service-role-key
SUPABASE_JWT_SECRET=your-dev-jwt-secret
APP_BASE_URL=http://localhost:5173
API_PUBLIC_BASE_URL=http://localhost:3000/api
PAYSTACK_PUBLIC_KEY=your-paystack-test-public-key
PAYSTACK_SECRET_KEY=your-paystack-test-secret-key
DAILY_API_KEY=your-daily-dev-api-key
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5-mini
SENTRY_DSN=
REDIS_URL=redis://localhost:6379
SUPER_ADMIN_BOOTSTRAP_SECRET=
