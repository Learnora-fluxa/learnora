# Full reference list of apps/web environment variables.
# - Local dev: copy to `.env.development.local` (git-ignored) — Vite loads it
#   automatically for `npm run dev`. Use the DEV Supabase project. See
#   docs/ENVIRONMENTS.md.
# - Deployed (Vercel): set these in Project Settings → Environment Variables,
#   scoped to "Production" (main branch, prod values) and separately to
#   "Preview" restricted to the `dev` branch (dev values). Never mix the two.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_API_BASE_URL=http://localhost:3000/api
