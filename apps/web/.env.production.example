# Reference only — this is what must be set as Vercel "Production" env vars,
# using your PRODUCTION Supabase project and the production Render API URL.
VITE_SUPABASE_URL=https://<your-prod-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=your-prod-anon-key
VITE_API_BASE_URL=https://api.learnora.example/api
